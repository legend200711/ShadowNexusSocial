{
  "projects": {
    "default": "horr-a08f4"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "database.rules.json",
      ".firebaserc",
      ".git/**",
      ".idea/**",
      ".wrangler/**",
      "node_modules/**",
      "snx-emulator-test/**",
      "archive/**",
      "push_to_github.ps1",
      "generate_icons.py",
      "wrangler.jsonc",
      "wrangler.toml",
      "wrangler-paypal.toml",
      "wrangler-paypal.jsonc",
      "*.bak",
      "*.bak2",
      "*.bak3",
      "_snx_diff.txt",
      "paypal-setup.md",
      "CNAME",
      "test-free-coin-flow.js",
      "firestore.rules.backup*"
    ],
    "rewrites": [
      {
        "source": "/cloud-stream",
        "destination": "/cloud-stream.html"
      },
      {
        "source": "/cloud-stream/**",
        "destination": "/cloud-stream.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
          { "key": "Pragma", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.@(js|mjs|html)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
