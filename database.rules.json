{
  "rules": {

    // ── Co-Host system ────────────────────────────────────────────────
    //
    //  cohosts/{liveId}/requests/{uid}
    //    - Host writes the initial invite (from == auth.uid)
    //    - Invitee (uid == auth.uid) updates status field only
    //    - Host (from == auth.uid) can read all; invitee reads their own
    //
    //  cohosts/{liveId}/active/{uid}
    //    - Only the invitee (uid == auth.uid) can create/update their own entry
    //    - Host (liveId starts with safeUid of host — not feasible in RTDB rules,
    //      so we allow any auth'd user to delete: host removes guests via their uid path)
    //
    //  cohosts/{liveId}/removed/{uid}
    //    - Any authenticated user can write (host removes a co-host)
    //
    //  cohosts/{liveId}/settings
    //    - Any authenticated user can read; any authenticated user can write
    //      (host is the only one who opens settings UI — enforced in client code)
    //
    "cohosts": {
      "$liveId": {

        // Settings — host reads and writes; viewers read
        "settings": {
          ".read":  "auth != null",
          ".write": "auth != null"
        },

        // Requests — host writes invite; invitee updates their own status
        "requests": {
          ".read": "auth != null",
          "$uid": {
            // Any authenticated user can create a request node
            // (host creates the initial invite, invitee never creates — only updates)
            ".write": "auth != null"
          }
        },

        // Active co-hosts — the invitee writes their own entry; any auth'd user can delete
        "active": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        },

        // Removed list — host writes when removing a co-host
        "removed": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        }
      }
    },

    // ── Live Rooms ────────────────────────────────────────────────────
    "liveRooms": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── WebRTC signaling (live-room.html / basic live system) ─────────
    //  liveSignaling/{roomId}/viewers/{viewerUid}
    //    → offer / answer / viewerIce / hostIce
    "liveSignaling": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── Viewer + host presence (live-room.html) ────────────────────────
    //  livePresence/{roomId}/host
    //  livePresence/{roomId}/viewers/{uid}
    "livePresence": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── WebRTC signaling — live.js (Shadow Nexus Social Live) ─────────
    // Structure: liveConnections/{hostUid}/viewers/{viewerUid}
    // Used exclusively by Shadow Nexus Social Live (live.html / live.js).
    // Studio Live uses studioLiveConnections — completely separate path.
    "liveConnections": {
      "$hostUid": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── WebRTC signaling — 24-Hour Studio Live ────────────────────────
    // Structure: studioLiveConnections/{hostUid}/viewers/{viewerUid}
    // Used exclusively by 24-Hour Studio (studio.js / studio-viewer.html).
    // Shadow Nexus Social Live uses liveConnections — completely separate path.
    // Both host and viewers are authenticated SNX users.
    // Any authenticated user can read/write — signaling data is ephemeral
    // and contains only SDP offers/answers and ICE candidates, no PII.
    "studioLiveConnections": {
      "$hostUid": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── Guest box requests ────────────────────────────────────────────
    "guestRequests": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── Guest WebRTC signaling ────────────────────────────────────────
    "guestSignaling": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── Guest presence in live rooms ──────────────────────────────────
    "liveGuests": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── Guest→viewer relay signaling (host relays guest streams to all viewers) ──
    "guestViewerSignaling": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── Storm Rooms ───────────────────────────────────────────────────
    "stormRooms": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── Support Rooms ─────────────────────────────────────────────────
    "supportRooms": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ── User presence — each user owns their own node ─────────────────
    "presence": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Per-user live status ──────────────────────────────────────────
    "userLive": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Online / live presence for friends list ───────────────────────
    "users": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }

  }
}
